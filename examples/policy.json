{
  "severity": ["unclassified", "read", "read_internal", "send_internal", "write", "read_sensitive",
               "send_external", "payment", "delete", "admin"],
  "high_impact": ["send_external", "payment", "delete", "admin"],
  "rules": [
    {"resource": "https://records.example", "class": "read_sensitive"},
    {"resource": "https://hr.example", "result_contains_any": ["national_id", "compensation", "home_address", "salary"], "class": "read_sensitive"},
    {"resource": "https://hr.example", "class": "read_internal", "if_unknown": "read_sensitive"},
    {"resource": "https://finance.example", "result_contains_any": ["iban", "salary", "restricted"], "class": "read_sensitive"},
    {"resource": "https://finance.example", "class": "read_internal", "if_unknown": "read_sensitive"},
    {"resource": "https://mail.example", "operation": "send_email", "param_domain_not_in": {"to": ["corp.example"]}, "class": "send_external"},
    {"resource": "https://mail.example", "operation": "send_email", "class": "send_internal", "if_unknown": "send_external"},
    {"resource": "https://mail.example", "scope": "mail.send", "class": "send_internal", "if_unknown": "send_external"},
    {"resource": "https://pay.example", "operation": "pay", "amount_param": "amount", "class": "payment"},
    {"resource": "https://pay.example", "class": "payment", "amount_param": "amount"},
    {"resource": "https://calendar.example", "class": "write"},
    {"resource": "*", "tool": "SendEmail", "param_domain_not_in": {"to": ["corp.example"]}, "class": "send_external"},
    {"resource": "*", "tool": "SendEmail", "class": "send_internal", "if_unknown": "send_external"},
    {"resource": "*", "tool": "ReadFile", "class": "read"},
    {"resource": "*", "tool": "WebSearch", "class": "read"}
  ],
  "prohibited_pairs": [["read_sensitive", "send_external"]],
  "prohibited_sequences": [["read_sensitive", "write", "send_internal"]],
  "budgets": {"payment": {"max_count": 3, "max_amount": 500000}},
  "deny_resources": ["https://exfil.example"],
  "allowed_tools": ["*"],
  "ask_tools": ["DeleteRepo"],
  "allow_unlisted_resources": false,
  "clarify_missing_justification": false,
  "max_mission_seconds": 2592000,
  "composition_on_certain": "deny",
  "r3_member": "r3_proposal",
  "resource_budgets": {"https://inference.example": {"unit": "USD", "decimals": 2, "max_amount": 2500}}
}
